{
  "name": "hgi-edge-runtime",
  "version": "0.1.0",
  "description": "Local-first, offline-capable inference runtime for HGI edge devices",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:llama": "jest adapters/llama_cpp",
    "example:llama": "node dist/examples/llama-cpp-basic.js",
    "example:llama:stream": "node dist/examples/llama-cpp-stream.js",
    "example:handoff": "node dist/examples/handoff-client-demo.js",
    "example:e2e": "node dist/examples/end-to-end-handoff.js",
    "lint": "eslint src tests examples adapters --ext .ts",
    "lint:fix": "eslint src tests examples adapters --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"examples/**/*.ts\" \"adapters/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "keywords": [
    "llm",
    "inference",
    "local",
    "edge",
    "runtime",
    "ai",
    "privacy",
    "offline"
  ],
  "author": "HGI",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.12",
    "@typescript-eslint/eslint-plugin": "^7.10.0",
    "@typescript-eslint/parser": "^7.10.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.7",
    "ts-jest": "^29.1.4",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/unicorniatech/HGI-EDGE-RUNTIME.git"
  },
  "dependencies": {
    "node-llama-cpp": "^3.18.1"
  }
}
